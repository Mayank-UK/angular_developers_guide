# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

# COPY paths are still relative to the build context (project root),
# so .docker/nginx/* correctly reference our files. nginx.conf relocates the
# pid + temp paths to /tmp so the process can run fully as the non-root `nginx`
# user (no privileged ports — we listen on 8080).
COPY .docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY .docker/nginx/default.conf /etc/nginx/conf.d/default.conf
# Angular 22 application builder emits to dist/<app-name>/browser/
COPY --from=builder /app/dist/angular_developers_guide/browser /usr/share/nginx/html

# The non-root `nginx` user only needs to read the html; own it for safety.
RUN chown -R nginx:nginx /usr/share/nginx/html

USER nginx

# Liveness probe — the container should answer on :8080.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:8080/ || exit 1

EXPOSE 8080
