FROM node:22-alpine

WORKDIR /app

# All COPY paths are relative to the build context (project root),
# not relative to where this Dockerfile lives.
COPY package*.json ./
# --legacy-peer-deps is deliberate: the latest STABLE NgRx is 21.1.1, whose
# peerDependencies pin @angular/core ^21, but this project is on Angular 22.1.
# The two work fine together at runtime (NgRx 22 is still in beta/rc with no
# stable cut as of 2026-08). Revisit once @ngrx/*@22 ships stable and upgrade
# then — at which point this flag (and the matching note in ARCHITECTURE.md)
# can be removed. See ARCHITECTURE.md "NgRx peer-dependency" for the full note.
RUN npm ci --legacy-peer-deps

COPY . .

EXPOSE 4200

# ng serve must bind 0.0.0.0 so the port is reachable outside the container.
# (The legacy --disable-host-check flag was removed in Angular 21+; the new
# dev server's host check is permissive for non-loopback binds, so binding
# 0.0.0.0 alone is enough to reach it from outside the container.)
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
